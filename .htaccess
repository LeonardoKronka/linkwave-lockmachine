# LinkWave · LockMachine — configuração do Apache (cPanel)
Options -Indexes
DirectoryIndex index.html index.php

# Para obrigar HTTPS, prefira o botão "Force HTTPS Redirect" em cPanel > Domains.
# Se não existir, tire o # das 4 linhas abaixo DEPOIS que https:// já estiver funcionando.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Tipos de arquivo usados pelo app e pelo download do APK
AddType application/manifest+json .webmanifest
AddType application/vnd.android.package-archive .apk
AddType font/woff2 .woff2

# Arquivos de desenvolvimento nunca são servidos
<FilesMatch "\.(sql|md|ino|ps1|sh|log)$">
  Require all denied
</FilesMatch>
# Controle da publicação automática (lista de arquivos enviados pelo GitHub)
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Só roda código servido por este domínio: sem scripts de terceiros nem scripts injetados
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Navegador lembra de usar sempre HTTPS (só é enviado quando a página já veio por HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
