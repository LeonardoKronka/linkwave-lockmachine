# Senha do banco: cada ambiente (PC, cPanel) cria a sua
api/config.local.php

# Sessões do PHP e contadores de tentativas criados enquanto o app roda
api/storage/sessoes/
api/storage/limites/

# Configuração do Claude Code com caminhos desta máquina
.claude/

# APK e pacote do PWABuilder. Do pacote, só o APK (em downloads/) e o assetlinks.json (em .well-known/)
# vão para o site. A chave de assinatura e as senhas NUNCA vão para o Git: ficam guardadas fora desta pasta.
downloads/*.apk
*.aab
*.idsig
*.keystore
*.jks
signing-key-info.txt
*Google Play package*

# Dependências do gerador da caixa 3D (npm install em firmware/caixa-3d)
node_modules/

# Arquivos do sistema
Thumbs.db
desktop.ini
.DS_Store

# Token da leitora e senha do Wi-Fi do firmware (cada um cria o seu a partir de segredos.exemplo.h)
firmware/lockmachine_esp32/segredos.h
